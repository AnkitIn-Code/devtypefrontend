#!/bin/sh
# .git/hooks/pre-commit — Secret scanner pre-commit hook
#
# Blocks commits that contain likely secrets (API keys, passwords, JWT secrets).
# Uses gitleaks if installed, falls back to regex grep for the most critical patterns.
#
# To install:
#   chmod +x .git/hooks/pre-commit
#   (or run: git config core.hooksPath .githooks and place this file there)
#
# To install gitleaks: https://github.com/gitleaks/gitleaks#install

echo "[pre-commit] Running secret scanner..."

# ── Option 1: Use gitleaks if available ──────────────────────────────────────
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --config .gitleaks.toml --redact
  if [ $? -ne 0 ]; then
    echo ""
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║  COMMIT BLOCKED: gitleaks detected potential secrets.        ║"
    echo "║  Review the output above and remove any hardcoded secrets.   ║"
    echo "║  Secrets belong in .env (git-ignored), never in code.        ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    exit 1
  fi
  echo "[pre-commit] ✓ No secrets detected by gitleaks."
  exit 0
fi

# ── Option 2: Fallback grep scan if gitleaks is not installed ─────────────────
echo "[pre-commit] gitleaks not found — using fallback grep pattern scan."
echo "[pre-commit] Install gitleaks for more thorough scanning: https://github.com/gitleaks/gitleaks#install"

STAGED=$(git diff --cached --name-only)

if [ -z "$STAGED" ]; then
  exit 0
fi

FOUND=0

for FILE in $STAGED; do
  if git show ":$FILE" 2>/dev/null | grep -qE \
    'fw_[A-Za-z0-9]{16,}|npg_[A-Za-z0-9]{10,}|re_[A-Za-z0-9]{16,}|jdbc:postgresql://[^@]+:[^@]+@|\$env:[A-Z_]*(PASSWORD|SECRET|KEY|TOKEN)\s*=\s*["'"'"'][^"'"'"']{10,}["'"'"']'; then
    echo "[pre-commit] ⚠ Possible secret detected in: $FILE"
    FOUND=1
  fi
done

if [ "$FOUND" -eq 1 ]; then
  echo ""
  echo "╔══════════════════════════════════════════════════════════════╗"
  echo "║  COMMIT BLOCKED: Possible secrets found in staged files.     ║"
  echo "║  Move credentials to .env (which is git-ignored).            ║"
  echo "║  Run 'gitleaks detect' for full analysis after installing it. ║"
  echo "╚══════════════════════════════════════════════════════════════╝"
  exit 1
fi

echo "[pre-commit] ✓ No obvious secrets detected."
exit 0
