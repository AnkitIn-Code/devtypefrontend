# DevType Backend — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL / Neon Database ────────────────────────────────────────────────
# Obtain from the Neon console → your project → Connection Details
DATABASE_URL=jdbc:postgresql://<neon-host>/<db-name>?sslmode=require
DB_USER=<your-neon-username>
DB_PASSWORD=<your-neon-password>

# ── JWT Signing Secret ────────────────────────────────────────────────────────
# Must be a Base64-encoded 256-bit (32-byte) random value.
# Generate a new one: openssl rand -base64 32
JWT_SECRET=<base64-encoded-256-bit-secret>

# ── Fireworks AI (DeepSeek-V4-Pro-0813) ──────────────────────────────────────
# Obtain from: https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=fw_<your-fireworks-api-key>

# ── CORS Allowed Origins ──────────────────────────────────────────────────────
# Comma-separated list of frontend origins.
# Default (if not set): http://localhost:5173,http://localhost:3000,http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001,http://localhost:5174

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Required only for sending real password-reset emails.
# Without this, reset links are logged to the console (dev mode only).
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY=re_<your-resend-api-key>
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Admin Bootstrap ──────────────────────────────────────────────────────────
# Set to an existing user's email to automatically promote them to ADMIN
# on the next application startup. Safe to leave blank.
# INITIAL_ADMIN_EMAIL=your-admin@example.com

# ── Dev Token Exposure ────────────────────────────────────────────────────────
# When set to true, POST /auth/forgot-password returns devResetToken in the
# response body (for local development without a real email provider).
# MUST be false (or unset) in any non-local environment.
EXPOSE_DEV_RESET_TOKEN=true

# ── Frontend URL (for email reset links) ─────────────────────────────────────
FRONTEND_URL=http://localhost:5173
